# URL de conexión a Aiven PostgreSQL
# Ejemplo: postgresql://avnadmin:password@host.aivencloud.com:14721/defaultdb?sslmode=require
AIVEN_DATABASE_URL=your_aiven_connection_string_here

# SMTP para envío de correos (ej. Gmail con contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM=tu_correo@gmail.com

# API keys para usar un modelo en la nube (opcional; también se pueden ingresar desde Ajustes)
GROQ_API_KEY=
OPENAI_API_KEY=
